# ---------------------------------------------------------------------------
# Sample environment file. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored. NEVER commit real tokens, keys, or passwords.
# Every value below is a placeholder — the stack runs end to end with these
# defaults except for ANTHROPIC_API_KEY (see LLM_PROVIDER note).
# ---------------------------------------------------------------------------

# --- Alarm Management API (the candidate-built simulator) ------------------
# Bearer token the simulator requires on every endpoint except /health.
# Matches the `auth_token` collection variable in the Postman collections.
ALARM_API_TOKEN=demo-token
ALARM_API_BASE_URL=http://alarm-simulator:8000
ALARM_API_TIMEOUT_SECONDS=5
ALARM_API_MAX_RETRIES=2

# Deterministic seed for the simulator's synthetic data generator.
# Changing this changes every asset_id and alarm_id in the demo.
ALARM_SIM_SEED=20260811
ALARM_SIM_DB_PATH=/data/alarms.db

# --- MCP servers -----------------------------------------------------------
MCP_ALARM_URL=http://mcp-alarm-management:9000
MCP_GITHUB_URL=http://mcp-github-issues:9001
MCP_CLIENT_ID=copilot-backend
MCP_TOOL_TIMEOUT_SECONDS=8

# --- LLM provider ----------------------------------------------------------
# anthropic  -> uses ANTHROPIC_API_KEY, full LLM planning and answer composition
# rule_based -> deterministic planner and template composer, no key required
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
ANTHROPIC_API_KEY=replace-me

# --- RAG -------------------------------------------------------------------
CHROMA_URL=http://chroma:8001
CHROMA_COLLECTION=operations-docs
DOCUMENT_PATH=./rag/documents
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
# Below this fused score the answer states that no relevant procedure was found
# rather than reaching for general knowledge.
RETRIEVAL_MIN_SCORE=0.35

# --- GitHub Issues MCP server ---------------------------------------------
# true  -> in-memory mock backend, no network, no credentials (default for demo)
# false -> real GitHub REST API, requires GITHUB_TOKEN and GITHUB_REPO
GITHUB_MOCK=true
GITHUB_TOKEN=replace-me
GITHUB_REPO=owner/repo

# --- Backend / observability ----------------------------------------------
BACKEND_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
