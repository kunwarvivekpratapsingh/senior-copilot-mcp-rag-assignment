# ---------------------------------------------------------------------------
# Sample environment file. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored. NEVER commit real tokens, keys, or passwords.
# Every value below is a placeholder — the stack runs end to end with these
# defaults except for ANTHROPIC_API_KEY (see LLM_PROVIDER note).
#
# Hosts and paths here are the LOCAL ones, so `make test` and a hand-started
# stack work with this file as-is. Docker Compose sets its own container values
# (service names, /data paths) per service, so it does not read them from here.
# ---------------------------------------------------------------------------

# --- Alarm Management API (the candidate-built simulator) ------------------
# Bearer token the simulator requires on every endpoint except /health.
# Matches the `auth_token` collection variable in the Postman collections.
ALARM_API_TOKEN=demo-token
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TIMEOUT_SECONDS=5
ALARM_API_MAX_RETRIES=2

# Deterministic seed for the simulator's synthetic data generator.
# Changing this changes every asset_id and alarm_id in the demo.
ALARM_SIM_SEED=20260811
# ":memory:" keeps the database in-process, which is what a local run wants.
# Compose overrides this with a path on a volume.
ALARM_SIM_DB_PATH=:memory:

# --- MCP servers -----------------------------------------------------------
# The path matters: the MCP streamable-HTTP transport is mounted at /mcp.
MCP_ALARM_URL=http://localhost:9000/mcp
MCP_GITHUB_URL=http://localhost:9001/mcp
MCP_CLIENT_ID=copilot-backend
MCP_TOOL_TIMEOUT_SECONDS=8

# --- LLM provider ----------------------------------------------------------
# rule_based -> deterministic planner and template composer, no key required.
#               The default, so a clean clone runs with no credentials at all.
# anthropic  -> uses ANTHROPIC_API_KEY for planning and answer composition.
#               Falls back to rule_based if the key is missing or still 'replace-me'.
LLM_PROVIDER=rule_based
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
ANTHROPIC_API_KEY=replace-me

# --- RAG -------------------------------------------------------------------
# Chroma runs embedded in the backend process, persisting to this directory —
# there is no separate vector-database service to start or wait for.
# Compose overrides this with a path on a volume.
CHROMA_PATH=.chroma
CHROMA_COLLECTION=operations-docs
DOCUMENT_PATH=./rag/documents
# hashing -> deterministic, dependency-free, no model download (the default).
# sentence-transformers/all-MiniLM-L6-v2 -> stronger dense recall; install the
# 'rag-transformers' extra and expect a ~90MB model download on first ingest.
EMBEDDING_MODEL=hashing
RETRIEVAL_TOP_K=5
# Below this fused score the answer states that no relevant procedure was found
# rather than reaching for general knowledge.
RETRIEVAL_MIN_SCORE=0.35

# --- GitHub Issues MCP server ---------------------------------------------
# true  -> in-memory mock backend, no network, no credentials (default for demo)
# false -> real GitHub REST API, requires GITHUB_TOKEN and GITHUB_REPO
GITHUB_MOCK=true
GITHUB_TOKEN=replace-me
GITHUB_REPO=owner/repo

# --- Backend / observability ----------------------------------------------
BACKEND_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend --------------------------------------------------------------
# The URL the BROWSER uses to reach the backend, so it is localhost and the host
# port — not the compose service name. Vite inlines it at build time, so changing
# it means rebuilding the frontend image.
VITE_API_BASE_URL=http://localhost:8080

# --- Host ports ------------------------------------------------------------
# Only the host side of each published port. Container-internal ports never change.
# Override these if something already listens on the default — then set
# VITE_API_BASE_URL to match BACKEND_HOST_PORT and rebuild the frontend:
#   BACKEND_HOST_PORT=8090 VITE_API_BASE_URL=http://localhost:8090 docker compose up --build
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
SIMULATOR_HOST_PORT=8000
