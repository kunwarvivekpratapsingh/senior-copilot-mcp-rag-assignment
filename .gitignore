# --- Secrets ---------------------------------------------------------------
# Only .env.example is committed. Real values never are.
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Node / frontend -------------------------------------------------------
node_modules/
apps/frontend/dist/
apps/frontend/.vite/
npm-debug.log*

# --- Runtime data ----------------------------------------------------------
# Generated by the simulator seeder and the RAG indexer; both are reproducible
# from source, so neither belongs in version control.
*.db
*.sqlite3
.chroma/
chroma-data/
data/

# --- Local model cache -----------------------------------------------------
# sentence-transformers downloads weights here. Baked into the image at build
# time instead of being committed.
.cache/
models/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
